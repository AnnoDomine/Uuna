Screen {
    background: #1a1b26;
    layout: vertical;
}

#header {
    height: 3;
    background: #24283b;
}

#footer {
    height: 1;
}

#app-body {
    height: 1fr;
    width: 100%;
    layout: horizontal;
}

#sidebar {
    width: 30;
    height: 100%;
    background: #24283b;
    border-right: tall #414868;
    padding: 1;
}

#main-content {
    width: 1fr;
    height: 100%;
    layout: vertical;
}

#view-title {
    text-style: bold;
    color: #7aa2f7;
    padding: 1;
    height: 3;
}

#content-area {
    height: 1fr;
    width: 100%;
    padding: 1;
    border-top: solid #414868;
}

#log-area {
    width: 60;
    height: 100%;
    background: #16161e;
    border-left: solid #414868;
}

#status-bar {
    height: 3;
    background: #24283b;
    border-top: tall #414868;
    layout: horizontal;
}

#status-bar Label {
    padding: 0 2;
    margin-top: 1;
}

#log-view {
    height: 1fr;
    width: 100%;
}

/* Settings Styles */
#settings-list {
    height: 1fr;
    border: solid #414868;
}

SettingItem {
    height: auto;
    padding: 1;
    border-bottom: solid #24283b;
    layout: horizontal;
}
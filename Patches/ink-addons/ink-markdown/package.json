{
  "name": "ink-markdown",
  "version": "1.0.4",
  "description": "Render markdown text using Ink",
  "main": "./build/index.js",
  "author": "Cameron Hunter <hello@cameronhunter.co.uk>",
  "license": "MIT",
  "keywords": [
    "ink-component",
    "ink",
    "component",
    "markdown",
    "react",
    "jsx",
    "terminal",
    "term",
    "console",
    "command-line"
  ],
  "type": "module",
  "scripts": {
    "prebuild": "rm -rf ./build",
    "build": "tsc",
    "format": "prettier --write ./**/*.{js,json,md,ts,tsx}",
    "test": "vitest",
    "preversion": "yarn build",
    "demo": "ts-node --transpile-only ./demo/index.tsx"
  },
  "files": [
    "./build"
  ],
  "dependencies": {
    "@changesets/cli": "^2.29.8",
    "marked": "^17.0.1",
    "marked-terminal": "^7.3.0"
  },
  "devDependencies": {
    "@types/dedent": "^0.7.2",
    "@types/ink-testing-library": "^1.0.4",
    "@types/marked": "^5.0.2",
    "@types/react": "^19.2.7",
    "dedent": "^1.7.0",
    "ink": ">=6.5.1",
    "ink-testing-library": "^4.0.0",
    "jest-snapshot-serializer-ansi": "^2.2.1",
    "prettier": "^3.7.4",
    "react": ">=19.2.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vitest": "^4.0.15"
  },
  "peerDependencies": {
    "ink": ">=4.4.1",
    "react": ">=16.8.0"
  }
}
